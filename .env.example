# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# On Vercel, pull synced env vars instead:
#   vercel link && vercel env pull .env.local --yes

# --- Transport for London (score / analyse context) ---
TFL_APP_ID=
TFL_APP_KEY=

# --- ElevenLabs Speech Engine (voice mode) ---
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_ENGINE_ID=

# --- Voice LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=https://sshldn.vercel.app

# --- Google Maps / Places ---
# Server-side Geocoding API (no NEXT_PUBLIC_ prefix; restrict by IP or use unrestricted server key).
GOOGLE_API_KEY=
# Browser Places Autocomplete + Maps JS (HTTP referrer: localhost:3999, sshldn.vercel.app).
NEXT_PUBLIC_GOOGLE_API=

# --- Optional weather ---
OPENWEATHER_API_KEY=

# --- Voice API (dev proxies to production when unset) ---
NEXT_PUBLIC_VOICE_API_URL=

# --- DEFRA tile source: local | wms (default local cache) ---
NOISE_TILE_SOURCE=local

# --- Voice WebSocket CORS (comma-separated origins) ---
VOICE_ALLOWED_ORIGINS=
